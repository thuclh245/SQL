# Sao chép thành .env rồi đổi giá trị. Không commit .env.
# Mật khẩu dưới đây chỉ là chỗ giữ chỗ — đổi trước khi dùng.

# --- Object storage (MinIO) ---
MINIO_ROOT_USER=lab_minio_admin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_CONSOLE_HOST_PORT=9001
LAKEHOUSE_BUCKET=lakehouse
S3_ENDPOINT=http://minio:9000

# --- Hive Metastore backing database ---
METASTORE_DB_NAME=metastore
METASTORE_DB_USER=hive
METASTORE_DB_PASSWORD=change-me-metastore

# --- Trino ---
# Cổng host; 8080 để dành cho Airflow của OpenMetadata nên mặc định dùng 8090.
TRINO_HOST_PORT=8090
# User dùng để nạp dữ liệu (được quyền ghi trong rules.json).
TRINO_LOADER_USER=lab_loader
# User ứng dụng T2S dùng để đọc (chỉ SELECT trong rules.json).
TRINO_APP_USER=t2s_app

# --- Phạm vi dữ liệu nạp vào lake ---
# sample8  : 8 bảng có tên trong mẫu OpenMetadata (cổng G1)
# benchmark: các bảng được 100 benchmark case sử dụng
# all      : toàn bộ 400 bảng / 20 schema
LAKEHOUSE_SCOPE=sample8
