{
  "e05_consumed_protocol_version": "e05.case_evidence.v1",
  "json_schema": {
    "$defs": {
      "ChatCallRecord": {
        "additionalProperties": false,
        "description": "Exact evidence for a single provider call (E04 §7, §9).\n\n``messages`` is the exact ordered prompt content handed to the chat client\n(the substantive prompt). Model configuration that lives on the client rather\nthan in the messages (temperature, token-limit parameter) is recorded once in\nthe experiment manifest and echoed in :class:`CaseRunRecord`. Secrets (API\nkeys, auth headers) are never captured (E04 §7).",
        "properties": {
          "elapsed_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Elapsed Ms"
          },
          "error_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Class"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Message"
          },
          "extracted_sql": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Extracted Sql"
          },
          "max_output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Output Tokens"
          },
          "messages": {
            "items": {
              "$ref": "#/$defs/ChatMessageRecord"
            },
            "title": "Messages",
            "type": "array"
          },
          "model_name_requested": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model Name Requested"
          },
          "model_name_returned": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model Name Returned"
          },
          "ordinal": {
            "title": "Ordinal",
            "type": "integer"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Output Tokens"
          },
          "prompt_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Prompt Hash"
          },
          "prompt_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Prompt Tokens"
          },
          "purpose": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Purpose"
          },
          "raw_model_output": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Raw Model Output"
          },
          "raw_model_output_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Raw Model Output Hash"
          },
          "reasoning_effort": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reasoning Effort"
          },
          "schema_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Schema Name"
          }
        },
        "required": [
          "ordinal"
        ],
        "title": "ChatCallRecord",
        "type": "object"
      },
      "ChatMessageRecord": {
        "additionalProperties": false,
        "description": "One ordered message in the exact prompt sent to the provider.",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessageRecord",
        "type": "object"
      },
      "EvidenceCompleteness": {
        "description": "Machine-checkable reconstructability of a case (E04 §12).",
        "enum": [
          "COMPLETE",
          "PARTIAL",
          "INSUFFICIENT"
        ],
        "title": "EvidenceCompleteness",
        "type": "string"
      },
      "GenerationOutcome": {
        "description": "Distinct generation/execution states (E04 §13).\n\nThese separate *how* a case ended so that a provider failure is never\nconflated with an empty generation, a rejected candidate, or a semantically\nwrong-but-executed answer.",
        "enum": [
          "PROVIDER_ERROR",
          "GENERATION_EMPTY",
          "SQL_EXTRACTION_ERROR",
          "VALIDATION_REJECTED",
          "EXECUTION_ERROR",
          "EXECUTION_SUCCESS",
          "ABSTAIN",
          "UNKNOWN"
        ],
        "title": "GenerationOutcome",
        "type": "string"
      },
      "GroundingCaptureRecord": {
        "additionalProperties": false,
        "description": "Exact grounding/context that entered the solver (E04 §8).\n\n``serialized_authorized_schema`` is the byte-for-byte string embedded in the\nsolver prompt. The structured fields are provenance for audit; they describe\nwhat was *selected*, distinct from what was merely retrieved.",
        "properties": {
          "example_count": {
            "default": 0,
            "title": "Example Count",
            "type": "integer"
          },
          "glossary_terms": {
            "items": {
              "type": "string"
            },
            "title": "Glossary Terms",
            "type": "array"
          },
          "ordinal": {
            "title": "Ordinal",
            "type": "integer"
          },
          "selected_columns": {
            "items": {
              "type": "string"
            },
            "title": "Selected Columns",
            "type": "array"
          },
          "selected_relationships": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Selected Relationships",
            "type": "array"
          },
          "selected_tables": {
            "items": {
              "type": "string"
            },
            "title": "Selected Tables",
            "type": "array"
          },
          "serialized_authorized_schema": {
            "default": "",
            "title": "Serialized Authorized Schema",
            "type": "string"
          },
          "serialized_context_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
