          "value_binding_columns": {
            "items": {
              "type": "string"
            },
            "title": "Value Binding Columns",
            "type": "array"
          }
        },
        "required": [
          "ordinal"
        ],
        "title": "GroundingCaptureRecord",
        "type": "object"
      }
    },
