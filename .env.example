# --- API ---
APP_NAME=t2s
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Solver (OpenAI-compatible endpoint: vLLM, OpenRouter, ...) ---
# Leave VLLM_BASE_URL empty to keep the API running without a runtime:
# /v1/query then answers "abstain" with policy runtime-not-configured-v1.
VLLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=gpt-oss-120b
LLM_REQUEST_TIMEOUT_SECONDS=120

# --- Runtime pipeline ---
# Configuring a catalog plus the database for the chosen dialect wires /v1/query to
# the full pipeline: grounding -> solver -> verification -> authorization ->
# read-only execution. Nothing falls back to another dialect: a missing or
# unsupported setting fails closed at startup.
RUNTIME_DEFAULT_DIALECT=sqlite
# Required when RUNTIME_DEFAULT_DIALECT=sqlite
RUNTIME_SQLITE_DATABASE_PATH=
# Required when RUNTIME_DEFAULT_DIALECT=postgres. Point it at a READ-ONLY role;
# the executor's READ ONLY transaction is a guard, not a substitute for that.
# e.g. postgresql://t2s_readonly:secret@localhost:5432/warehouse
RUNTIME_DATABASE_URL=
RUNTIME_DATABASE_CONNECT_TIMEOUT_SECONDS=10
RUNTIME_CATALOG_TABLES_PATH=
# Set when the catalog file is a multi-database schema manifest, to pick one
# database out of it; otherwise the file must be a JSON list of CatalogTable objects.
RUNTIME_CATALOG_DATABASE_ID=
RUNTIME_API_USER_ID=api-user
VALIDATOR_MODE=shadow

# --- Execution limits ---
DATABASE_MAX_RESULT_ROWS=1000
DATABASE_STATEMENT_TIMEOUT_SECONDS=30

# Example of a fully wired local runtime using the bundled BIRD mini-dev data:
# VLLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL_NAME=openai/gpt-oss-120b
# RUNTIME_SQLITE_DATABASE_PATH=data/bird_mini_dev/schema_only_databases/california_schools/california_schools.sqlite
# RUNTIME_CATALOG_TABLES_PATH=data/bird_mini_dev/mini_dev_tables.json
# RUNTIME_CATALOG_DATABASE_ID=california_schools
