# --- API ---
APP_NAME=t2s
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Solver (OpenAI-compatible endpoint: vLLM, OpenRouter, ...) ---
# Leave VLLM_BASE_URL empty to keep the API running without a runtime:
# /v1/query then answers "abstain" with policy runtime-not-configured-v1.
VLLM_BASE_URL=
LLM_API_KEY=
LLM_PROVIDER=openai_compatible
LLM_MODEL_NAME=gpt-oss-120b
LLM_TEMPERATURE=0.0
LLM_REQUEST_TIMEOUT_SECONDS=120

# --- Runtime pipeline ---
# Configuring a catalog plus the database for the chosen dialect wires /v1/query to
# the full pipeline: grounding -> solver -> verification -> authorization ->
# read-only execution. Nothing falls back to another dialect: a missing or
# unsupported setting fails closed at startup.
RUNTIME_DEFAULT_DIALECT=sqlite
# Required when RUNTIME_DEFAULT_DIALECT=sqlite
RUNTIME_SQLITE_DATABASE_PATH=
# Required when RUNTIME_DEFAULT_DIALECT=postgres. Point it at a READ-ONLY role;
# the executor's READ ONLY transaction is a guard, not a substitute for that.
# e.g. postgresql://t2s_readonly:secret@localhost:5432/warehouse
RUNTIME_DATABASE_URL=
RUNTIME_DATABASE_CONNECT_TIMEOUT_SECONDS=10
RUNTIME_CATALOG_TABLES_PATH=
# Set when the catalog file is a multi-database schema manifest, to pick one
# database out of it; otherwise the file must be a JSON list of CatalogTable objects.
RUNTIME_CATALOG_DATABASE_ID=
RUNTIME_API_USER_ID=api-user
VALIDATOR_MODE=shadow

# Canonical runtime/benchmark semantic profile. v003 and evidence-enabled runs
# remain explicit experiments; do not promote them by changing these defaults.
RUNTIME_PROMPT_VERSION=v001
RUNTIME_EVIDENCE_MODE=none
SEMANTIC_PLANNER_MODE=off
# The verifier is a post-execution advisory signal and accepts plan=None when
# the planner is off.
RESULT_VERIFIER_ENABLED=true

# --- Execution database readiness ---
# Startup fails when the configured execution database contains no rows in any
# relation. Such a database answers every query with NULL, which reads as poor
# model accuracy rather than as the misconfiguration it is. Set to false only if
# you deliberately intend to serve an empty database.
RUNTIME_REQUIRE_POPULATED_EXECUTION_DATABASE=true
RUNTIME_READINESS_RELATION_SAMPLE_SIZE=25

# --- Abstention posture ---
# true: a candidate that parses, is authorized and references only grounded
#       relations proceeds, carrying any caveats the solver reported as warnings.
# false: any uncertainty the solver reports blocks the query. Choose this where an
#       unreviewed answer costs more than no answer.
RELEASE_CANDIDATES_WITH_CAVEATS=true

# --- Value grounding (value linking) ---
# Reads candidate literals from the execution database so the solver filters on
# values that exist rather than guessing their spelling. Probes are read-only,
# parameterized, and restricted to columns already present in the grounding
# context. Cost per request is bounded by MAX_VALUE_COLUMNS * 2 round trips.
VALUE_GROUNDING_ENABLED=false
MAX_VALUE_COLUMNS=6
MAX_VALUE_CANDIDATES_PER_COLUMN=5
VALUE_LOOKUP_TIMEOUT_MS=1500
ENUMERATE_LOW_CARDINALITY_DOMAINS=true
MAX_ENUMERATED_DOMAIN_VALUES=12

# --- Grounding representation budget (shared with canonical benchmark runs) ---
RUNTIME_MAX_CANDIDATE_TABLES=50
RUNTIME_MAX_HYDRATED_TABLES=8
RUNTIME_MAX_COLUMNS_PER_TABLE=12
RUNTIME_MAX_TOTAL_COLUMNS=60
RUNTIME_MAX_RELATIONSHIPS=16
RUNTIME_RELATIONSHIP_EXPANSION_MODE=conditional
RUNTIME_FILL_COLUMN_BUDGET=false
RUNTIME_SMALL_DB_THRESHOLD=0
RUNTIME_MAX_ESCALATIONS=1

# --- Execution limits ---
DATABASE_MAX_RESULT_ROWS=1000
DATABASE_STATEMENT_TIMEOUT_SECONDS=30

# --- Metadata provider ---
# Leave unset for the default: T2S picks 'static' when RUNTIME_CATALOG_TABLES_PATH
# is provided, or 'postgres' when only RUNTIME_DATABASE_URL is set on the
# postgres dialect. Explicitly set to 'openmetadata' only in a LAB deployment
# profile with the OpenMetadata block below configured.
# METADATA_PROVIDER=openmetadata

# --- OpenMetadata (LAB metadata source, opt-in) ---
# T2S consumes OpenMetadata read-only. The runtime never writes to OM. If
# METADATA_PROVIDER=openmetadata is set, OPENMETADATA_URL is required and
# OPENMETADATA_PILOT_FQNS is strongly recommended: OpenMetadataProvider refuses
# unrestricted acquisition, so without an explicit pilot list (or a
# MetadataScope) the first metadata fetch fails closed with
# "Unrestricted acquisition is prohibited." Provide the fully-qualified names
# T2S is authorized to see, one per entry, comma-separated.
# OPENMETADATA_URL=https://openmetadata.internal
# OPENMETADATA_AUTH_TOKEN=              # bot JWT; never commit values
# OPENMETADATA_PILOT_FQNS=warehouse.analytics.sales.customers,warehouse.analytics.sales.orders
# OPENMETADATA_SERVICE_NAME=openmetadata
# OPENMETADATA_REQUEST_TIMEOUT_SECONDS=30
# OPENMETADATA_MAX_ASSETS=25
# OPENMETADATA_MAX_RETRIES=3

# Example of a fully wired local runtime.
#
# RUNTIME_SQLITE_DATABASE_PATH must point at a database that holds data. The
# bundled `data/bird_mini_dev/schema_only_databases/` copies carry structure only
# and are there for catalog and schema work; pointing the runtime at one makes
# every query return NULL. Value grounding also reads from this database, so it
# produces no bindings unless the database is populated.
# VLLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL_NAME=openai/gpt-oss-120b
# RUNTIME_SQLITE_DATABASE_PATH=/absolute/path/to/populated/california_schools.sqlite
# RUNTIME_CATALOG_TABLES_PATH=data/bird_mini_dev/mini_dev_tables.json
# RUNTIME_CATALOG_DATABASE_ID=california_schools
